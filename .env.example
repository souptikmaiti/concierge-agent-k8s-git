# Copy to .env and provide your Google API key. Keep .env out of Git.
GOOGLE_API_KEY=
CONCIERGE_MODEL=gemini-3.6-flash
# Google recommends 1.0 for Gemini 3; lower values can degrade reasoning.
CONCIERGE_TEMPERATURE=1.0
CONCIERGE_BASE_URL=http://localhost:8000
PORT=8000

# Base URLs of the independently running A2A services (not their MCP servers).
GIT_AGENT_URL=http://127.0.0.1:8001
K8S_AGENT_URL=http://127.0.0.1:8002
SPECIALIST_TIMEOUT_SECONDS=180

